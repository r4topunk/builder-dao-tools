{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    // No maps: `files` excludes `src/`, so any emitted *.map in the published
    // tarball would point at sources that aren't there.
    "declarationMap": false,
    "sourceMap": false
  }
}
